# ── Askyan Expeditions — environment ─────────────────────────────────────────
# Local dev: copy to .env. Production: set these in Vercel → Settings →
# Environment Variables.

# Postgres connection string (required — waitlist, contact form, analytics).
# Supabase: Project → Connect → "Transaction pooler" URI (port 6543).
# Create the tables by pasting supabase-setup.sql into the SQL Editor.
DATABASE_URL=

# Concierge chat — FREE providers, no card needed. Get a key from either:
#   Groq:   https://console.groq.com  (key starts gsk_...)
#   Gemini: https://aistudio.google.com/apikey  (key starts AIza...)
# The provider/model is auto-detected from the key shape.
AI_API_KEY=

# Optional overrides (rarely needed):
# AI_BASE_URL=
# AI_MODEL=
